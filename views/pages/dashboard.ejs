<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Transition - Dashboard</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/main.css" />
    <link rel="icon" type="image" href="/images/favicon.png" />
  </head>

  <body>
    <%- include('../partials/header') %>

    <div class="dashboard">
      <h2 class="animate-fade-in">Welcome <%= user.username %></h2>

      <div class="stats-container">
        <div class="stat-box">
          <h3>CO2 Saved</h3>
          <p>
            <%= stats && stats.overall ? stats.overall.co2Saved.toFixed(2) :
            '0.00' %> kg
          </p>
        </div>
        <div class="stat-box">
          <h3>Calories Burned</h3>
          <p>
            <%= stats && stats.overall ? Math.round(stats.overall.totalCalories)
            : '0' %> kcal
          </p>
        </div>
        <div class="stat-box">
          <h3>Distance Traveled</h3>
          <p>
            <%= stats && stats.overall ? (stats.overall.totalDistance /
            1000).toFixed(2) : '0.00' %> km
          </p>
        </div>
        <div class="stat-box">
          <h3>Total Time</h3>
          <p>
            <%= stats && stats.overall ? Math.round(stats.overall.totalTime /
            60) : '0' %> min
          </p>
        </div>
        <div class="stat-box">
          <h3>Total Trips</h3>
          <p><%= stats && stats.overall ? stats.overall.tripCount : '0' %></p>
        </div>
      </div>
    </div>

    <%- include('../partials/bottomNav') %>

    <script src="/scripts/header.js"></script>
  </body>
</html>
