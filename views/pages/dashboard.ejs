<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Transition - Dashboard</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/main.css" />
    <link rel="icon" type="image" href="/images/favicon.png" />
  </head>

  <body>
    <%- include('../partials/header') %>

    <div class="dashboard">
      <h2 class="animate-fade-in">Welcome,<br><%= user.username %></h2>

      <!-- Green Score Tree Visualization -->
      <div class="green-score-container">
        <h3>Your Green Score</h3>
        <div class="tree-container">
          <div class="tree" data-score="<%= stats && stats.overall ? stats.overall.greenScore : 50 %>">
            <!-- Tree trunk -->
            <div class="trunk"></div>
            <!-- Tree foliage -->
            <div class="foliage">
              <div class="leaf leaf-1"></div>
              <div class="leaf leaf-2"></div>
              <div class="leaf leaf-3"></div>
              <div class="leaf leaf-4"></div>
              <div class="leaf leaf-5"></div>
              <div class="leaf leaf-6"></div>
              <div class="leaf leaf-7"></div>
              <div class="leaf leaf-8"></div>
              <div class="leaf leaf-9"></div>
              <div class="leaf leaf-10"></div>
              <div class="leaf leaf-11"></div>
              <div class="leaf leaf-12"></div>
            </div>
          </div>
          <div class="score-display">
            <span class="score-number"><%= stats && stats.overall ? stats.overall.greenScore : 50 %></span>
            <span class="score-label">/100</span>
          </div>
        </div>
        <p class="score-description">
          <% const score = stats && stats.overall ? stats.overall.greenScore : 50; %>
          <% if (score >= 80) { %>
            🌟 Excellent! You're making a huge environmental impact!
          <% } else if (score >= 60) { %>
            🌱 Great job! Keep choosing green transportation!
          <% } else if (score >= 40) { %>
            🌿 Good start! Try walking or cycling more often.
          <% } else { %>
            🌱 Every journey counts! Start small with green choices.
          <% } %>
        </p>
      </div>

      <div class="stats-container">
        <div class="stat-box">
          <h3>CO2 Saved</h3>
          <p>
            <%= stats && stats.overall ? stats.overall.co2Saved.toFixed(2) :
            '0.00' %> kg
          </p>
          <% if (stats && stats.overall && stats.overall.co2Saved > 0) { %>
            <p class="comparison-text">
              <% 
                const co2 = stats.overall.co2Saved;
                const treeDays = co2 / 0.0597;
                const treeYears = co2 / 21.8;
                let comparison = '';
                if (treeYears >= 1) {
                  const trees = treeYears.toFixed(1);
                  comparison = `🌳 ${trees} tree${trees != 1 ? 's' : ''} for a year`;
                } else if (treeDays >= 1) {
                  const days = treeDays.toFixed(0);
                  comparison = `🌳 1 tree for ${days} day${days != 1 ? 's' : ''}`;
                } else {
                  const hours = (treeDays * 24).toFixed(0);
                  comparison = `🌳 1 tree for ${hours} hour${hours != 1 ? 's' : ''}`;
                }
              %>
              (<%= comparison %>)
            </p>
          <% } %>
        </div>
        <div class="stat-box">
          <h3>Calories Burned</h3>
          <p>
            <%= stats && stats.overall ? Math.round(stats.overall.totalCalories)
            : '0' %> kcal
          </p>
          <% if (stats && stats.overall && stats.overall.totalCalories > 0) { %>
            <p class="comparison-text">
              <% 
                const cals = stats.overall.totalCalories;
                let comparison = '';
                if (cals >= 285) {
                  const count = (cals / 285).toFixed(1);
                  comparison = `🍕 ${count} slice${count != 1 ? 's' : ''} of pizza`;
                } else if (cals >= 230) {
                  const count = (cals / 230).toFixed(1);
                  comparison = `🍫 ${count} chocolate bar${count != 1 ? 's' : ''}`;
                } else if (cals >= 105) {
                  const count = (cals / 105).toFixed(1);
                  comparison = `🍌 ${count} banana${count != 1 ? 's' : ''}`;
                } else {
                  const count = (cals / 95).toFixed(1);
                  comparison = `🍎 ${count} apple${count != 1 ? 's' : ''}`;
                }
              %>
              (<%= comparison %>)
            </p>
          <% } %>
        </div>
        <div class="stat-box">
          <h3>Distance Traveled</h3>
          <p>
            <%= stats && stats.overall ? (stats.overall.totalDistance /
            1000).toFixed(2) : '0.00' %> km
          </p>
        </div>
        <div class="stat-box">
          <h3>Total Time</h3>
          <p>
            <%= stats && stats.overall ? Math.round(stats.overall.totalTime /
            60) : '0' %> min
          </p>
        </div>
        <div class="stat-box">
          <h3>Total Trips</h3>
          <p><%= stats && stats.overall ? stats.overall.tripCount : '0' %></p>
        </div>
      </div>
    </div>

    <%- include('../partials/bottomNav') %>

    <script src="/scripts/header.js"></script>
    <style>
      .comparison-text {
        font-size: 0.85em;
        color: #666;
        margin-top: 5px;
        font-style: italic;
      }
    </style>
  </body>
</html>
