<!DOCTYPE html>
<html lang="en">
<head>
    <title>Core29</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles/main.css"/>
    <link rel="icon" type="image" href="public/images/favicon-128x128.png">
</head>
<body>
<div class="loginHero">
    <div class="loginLogo">
        <img src="public/images/core29-logo-white.png" alt="Logo"/>
    </div>
</div>
<div class="loginHero">
            
                <img class="loginLogo" src="/images/logo/stock-high-resolution-logo-white-transparent.png" alt="Logo"/>
            
        </div>
        <div class="login">
             
            <div class="loginForm">
                <form autocomplete="off" action="/login" method="post">
                    <div class="form-group">
                        <input type="text" name="username" class="form-control" placeholder="Username">
                    </div>    
                    <div class="form-group">
                        <input type="password" name="password" class="form-control" placeholder="Password">
                    </div>
                    <div class="form-group">
                        <input type="submit" class="btn btn-primary" value="Login"></input>
                    </div>
                </form>
            </div>
        </div>
</body>
</html>
