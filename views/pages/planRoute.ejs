<!DOCTYPE html>
<html lang="en">

<script>
 srcConcat="https://maps.googleapis.com/maps/api/js?key="+apiKey+"&libraries=maps,marker"
 src = srcConcat
    defer
</script>

<script src="/scripts/centreOnUser.js"></script>

<head>
    <title>Transistion</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles/main.css"/>
    <link rel="icon" type="image" href="../../public/images/favicon.png">
</head>
<body>

<gmp-map
    center="37.4220656,-122.0840897"
    zoom="10"
    map-id="DEMO_MAP_ID"
    style="width: 350px;height: 500px"></gmp-map>

<button id="locate-btn" onclick="centerOnUser()">Use My Location</button>

<form action="/submit" method="POST" onsubmit="return validateSelection()">

  <div class="image-button-group">

    <input type="checkbox" id="walk" name="modes" value="walk" hidden>
    <label for="walk" class="image-btn">
      <img src="/images/walkingicon.png" alt="Walk">
    </label>

    <input type="checkbox" id="bike" name="modes" value="bike" hidden>
    <label for="bike" class="image-btn">
      <img src="/images/bikeicon.png" alt="Bike">
    </label>

    <input type="checkbox" id="bus" name="modes" value="bus" hidden>
    <label for="bus" class="image-btn">
      <img src="/images/busicon.png" alt="Bus">
    </label>

    <input type="checkbox" id="car" name="modes" value="car" hidden>
    <label for="car" class="image-btn">
      <img src="/images/caricon.png" alt="Car">
    </label>

  </div>

  <br>
  <button type="submit">Submit</button>
</form>

<script src="/scripts/validateSelection.js" defer></script>
</body>
</html>


