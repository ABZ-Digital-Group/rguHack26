<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Transition</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles/main.css"/>
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/map') %>

        <div class="submit-container">
          <button type="submit" class="submit-btn" id="start-journey-btn">
            Start Journey
          </button>
        </div>
      </form>
    </main>

    <%- include('../partials/bottomNav') %>

  <script src="/scripts/header.js"></script>

    <script src="/scripts/validateSelection.js" defer></script>
    <script>
      async function handleStartJourney(event) {
        event.preventDefault();

        // Validate selection
        if (!validateSelection()) {
          return false;
        }

        const selectedMode = document.querySelector(
          'input[name="selectedMode"]:checked',
        );
        if (!selectedMode) {
          alert("Please select a route to start your journey.");
          return false;
        }

        const mode = selectedMode.value;
        const route = routeData[mode];

        if (!route) {
          alert("Route data not found. Please try again.");
          return false;
        }

        // Get addresses from map inputs
        const startAddress =
          document.getElementById("start-address")?.value || "";
        const endAddress = document.getElementById("end-address")?.value || "";

        // Get coordinates
        const startCoords = startMarker
          ? {
              lat: startMarker.getPosition().lat(),
              lng: startMarker.getPosition().lng(),
            }
          : null;

        const endCoords = endMarker
          ? {
              lat: endMarker.getPosition().lat(),
              lng: endMarker.getPosition().lng(),
            }
          : null;

        const btn = document.getElementById("start-journey-btn");
        btn.disabled = true;
        btn.textContent = "Starting Journey...";

        try {
          const response = await fetch("/api/journey/start", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              mode: mode,
              startAddress: startAddress,
              endAddress: endAddress,
              startCoords: startCoords,
              endCoords: endCoords,
              routeData: route,
              allRoutesData: routeData,
            }),
          });

          if (!response.ok) {
            throw new Error("Failed to start journey");
          }

          const data = await response.json();

          // Redirect to active journey page
          window.location.href = "/route";
  } catch (error) {
    console.error("Error starting journey:", error);
    alert("Failed to start journey. Please try again.");
    btn.disabled = false;
    btn.textContent = "Start Journey";
  }

  return false;
}
</script>

</body>
</html>
